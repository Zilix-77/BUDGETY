{
  "entities": {
    "Profile": {
      "title": "BudgetyProfile",
      "description": "User profile with onboarding, family configurations, and settings",
      "type": "object",
      "properties": {
        "onboarded": { "type": "boolean" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "familySize": { "type": "number" },
        "biggestFinancialIssue": { "type": "string" },
        "dailyNotesEnabled": { "type": "boolean" },
        "alertsEnabled": { "type": "boolean" },
        "trackNoteShortcutAdded": { "type": "boolean" },
        "telegramNotificationsEnabled": { "type": "boolean" },
        "phoneNumber": { "type": "string" },
        "telegramChatId": { "type": "string" }
      },
      "required": ["onboarded", "name", "email"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Individual daily budget transaction entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string" },
        "isFixedCommitment": { "type": "boolean" }
      },
      "required": ["id", "title", "amount", "category", "type", "date"]
    },
    "CustomCategory": {
      "title": "CustomCategory",
      "description": "Customizable budget envelopes and category limit goals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "monthlyBudgetLimit": { "type": "number" }
      },
      "required": ["id", "name", "type", "monthlyBudgetLimit"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "User savings milestone metrics and target dates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "savedAmount": { "type": "number" }
      },
      "required": ["id", "name", "targetAmount", "targetDate", "savedAmount"]
    },
    "ScratchpadNote": {
      "title": "ScratchpadNote",
      "description": "Active temporary scratchpad note text content with timestamp",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["content", "timestamp"]
    },
    "ScratchpadArchive": {
      "title": "ScratchpadArchive",
      "description": "Deep historical scratchpad text content archived on 3 day roll",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "content", "date"]
    },
    "IOTrackerEntry": {
      "title": "IOTrackerEntry",
      "description": "Hand-to-hand credit ledger entry to track money given or received back",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "personName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "type", "personName", "amount", "date", "status"]
    },
    "MonthlyBill": {
      "title": "MonthlyBill",
      "description": "Recurring monthly bills that are either pending or settled",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "monthKey": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "amount", "monthKey", "status"]
    },
    "PastMonthSummary": {
      "title": "PastMonthSummary",
      "description": "Rollboard archive stats of historical months",
      "type": "object",
      "properties": {
        "monthKey": { "type": "string" },
        "totalIncome": { "type": "number" },
        "totalSpent": { "type": "number" },
        "totalSaved": { "type": "number" }
      },
      "required": ["monthKey", "totalIncome", "totalSpent", "totalSaved"]
    },
    "SpecialMonthTag": {
      "title": "SpecialMonthTag",
      "description": "Active seasonal spikes classifications for particular months",
      "type": "object",
      "properties": {
        "monthKey": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["monthKey", "reason"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "Profile",
      "description": "Base level document storing user profiles"
    },
    "users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of all expenses and transactional entries"
    },
    "users/{userId}/categories/{categoryId}": {
      "schema": "CustomCategory",
      "description": "User specific budget limit envelopes"
    },
    "users/{userId}/goals/{goalId}": {
      "schema": "SavingsGoal",
      "description": "User specific savings goal targets"
    },
    "users/{userId}/notes/scratchpad": {
      "schema": "ScratchpadNote",
      "description": "Active single scratchnote configuration"
    },
    "users/{userId}/notes_archive/{archiveId}": {
      "schema": "ScratchpadArchive",
      "description": "History of expired scratch notes"
    },
    "users/{userId}/iotracker/{ioId}": {
      "schema": "IOTrackerEntry",
      "description": "Records of given/received hand loans"
    },
    "users/{userId}/bills/{billId}": {
      "schema": "MonthlyBill",
      "description": "Tracking documents for recurrent monthly bills"
    },
    "users/{userId}/monthhistory/{historyId}": {
      "schema": "PastMonthSummary",
      "description": "Monthly roll forward transaction archives"
    },
    "users/{userId}/specialmonths/{specialId}": {
      "schema": "SpecialMonthTag",
      "description": "Holiday reason designations per month"
    }
  }
}
