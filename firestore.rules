rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net - default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitives and global safety checks
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // MATCH USERS & SUBCOLLECTIONS Group
    match /users/{userId} {
      // Profiles are restricted to the owner only
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.onboarded is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100;
        
      // Match Expenses
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(expenseId)
          && request.resource.data.id == expenseId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 150
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.category is string
          && request.resource.data.type is string
          && request.resource.data.date is string;
        allow delete: if isOwner(userId);
      }
      
      // Match Categories
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(categoryId)
          && request.resource.data.id == categoryId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.type is string
          && request.resource.data.monthlyBudgetLimit is number;
        allow delete: if isOwner(userId);
      }
      
      // Match Goals
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(goalId)
          && request.resource.data.id == goalId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.targetAmount is number
          && request.resource.data.savedAmount is number;
        allow delete: if isOwner(userId);
      }
      
      // Match Active Scratchpad Document
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
      
      // Match Notes Archive
      match /notes_archive/{archiveId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(archiveId)
          && request.resource.data.id == archiveId
          && request.resource.data.content is string;
        allow delete: if isOwner(userId);
      }
      
      // Match IOTracker Ledger
      match /iotracker/{ioId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(ioId)
          && request.resource.data.id == ioId
          && request.resource.data.personName is string
          && request.resource.data.personName.size() <= 100
          && request.resource.data.amount is number;
        allow delete: if isOwner(userId);
      }
      
      // Match Bills
      match /bills/{billId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(billId)
          && request.resource.data.id == billId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 150
          && request.resource.data.amount is number;
        allow delete: if isOwner(userId);
      }
      
      // Match MonthHistory
      match /monthhistory/{historyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.monthKey is string
          && request.resource.data.totalIncome is number
          && request.resource.data.totalSpent is number;
        allow delete: if isOwner(userId);
      }
      
      // Match SpecialMonths
      match /specialmonths/{specialId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.monthKey is string
          && request.resource.data.reason is string;
        allow delete: if isOwner(userId);
      }
    }
  }
}
